{"id":"o3-07","label":"III.7","group":"Liber III","blocks":[{"k":"v","lines":["Quid fles, Asterie, quem tibi candidi","Primo restituent vere Favonii","Thyna merce beatum,","Constantis juvenem fide,"]},{"k":"v","lines":["Gygen? Ille Notis actus ad Oricum","Post insana Caprae sidera frigidas","Noctes non sine multis","Insomnis lacrimis agit."]},{"k":"v","lines":["Atqui sollicitae nuntius hospitae,","Suspirare Chloën et miseram tuis","Dicens ignibus uri,","Tentat mille vafer modis."]},{"k":"v","lines":["Ut Proetum mulier perfida credulum","Falsis impulerit criminibus nimis","Casto Bellerophonti","Maturare necem, refert."]},{"k":"v","lines":["Narrat paene datum Pelea Tartaro,","Magnessam Hippolyten dum fugit abstinens;","Et peccare docentes","Fallax historias movet."]},{"k":"v","lines":["Frustra: nam scopulis surdior Icari","Voces audit adhuc integer. At tibi","Ne vicinus Enipeus","Plus justo placeat cave;"]},{"k":"v","lines":["Quamvis non alius flectere equum sciens","Aeque conspicitur gramine Martio,","Nec quisquam citus aeque","Tusco denatat alveo."]},{"k":"v","lines":["Prima nocte domum claude neque in vias","Sub cantu querulae despice tibiae,","Et te saepe vocanti","Duram difficilis mane."]}]}