{"id":"o1-25","label":"I.25","group":"Liber I","blocks":[{"k":"v","lines":["Parcius junctas quatiunt fenestras","Ictibus crebris juvenes protervi,","Nec tibi somnos adimunt, amatque","Janua limen,"]},{"k":"v","lines":["Quae prius multum facilis movebat","Cardines; audis minus et minus jam:","“Me tuo longas pereunte noctes,","Lydia, dormis?”"]},{"k":"v","lines":["Invicem moechos anus arrogantes","Flebis in solo levis angiportu,","Thracio bacchante magis sub inter-","lunia vento,"]},{"k":"v","lines":["Cum tibi flagrans amor et libido","Quae solet matres furiare equorum","Saeviet circa jecur ulcerosum,","Non sine questu"]},{"k":"v","lines":["Laeta quod pubes hedera virente","Gaudeat pulla magis atque myrto,","Aridas frondes hiemis sodali","Dedicet Hebro."]}]}