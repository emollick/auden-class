{"id":"o4-03","label":"IV.3","group":"Liber IV","blocks":[{"k":"v","lines":["Quem tu, Melpomene, semel","Nascentem placido lumine videris,","Illum non labor Isthmius","Clarabit pugilem, non equus impiger"]},{"k":"v","lines":["Curru ducet Achaico","Victorem, neque res bellica Deliis","Ornatum foliis ducem,","Quod regum tumidas contuderit minas,"]},{"k":"v","lines":["Ostendet Capitolio:","Sed quae Tibur aquae fertile praefluunt","Et spissae nemorum comae","Fingent Aeolio carmine nobilem."]},{"k":"v","lines":["Romae principis urbium","Dignatur suboles inter amabiles","Vatum ponere me choros,","Et jam dente minus mordeor invido."]},{"k":"v","lines":["O, testudinis aureae","Dulcem quae strepitum, Pieri, temperas,","O mutis quoque piscibus","Donatura cycni, si libeat, sonum,"]},{"k":"v","lines":["Totum muneris hoc tui est:","Quod monstror digito praetereuntium","Romanae fidicen lyrae,","Quod spiro et placeo, si placeo, tuum est."]}]}