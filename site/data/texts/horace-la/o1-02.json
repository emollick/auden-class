{"id":"o1-02","label":"I.2","group":"Liber I","blocks":[{"k":"v","lines":["Jam satis terris nivis atque dirae","Grandinis misit Pater, et rubente","Dextera sacras jaculatus arces","Terruit Urbem,"]},{"k":"v","lines":["Terruit gentes, grave ne rediret","Seculum Pyrrhae nova monstra questae,","Omne cum Proteus pecus egit altos","Visere montes,"]},{"k":"v","lines":["Piscium et summa genus haesit ulmo","Nota quae sedes fuerat columbis,","Et superjecto pavidae natarunt","Aequore damae."]},{"k":"v","lines":["Vidimus flavum Tiberim retortis","Littore Etrusco violenter undis","Ire dejectum monumenta regis","Templaque Vestae;"]},{"k":"v","lines":["Iliae dum se nimium querenti","Jactat ultorem, vagus et sinistra","Labitur ripa Jove non probante u-","xorius amnis."]},{"k":"v","lines":["Audiet cives acuisse ferrum","Quo graves Persae melius perirent;","Audiet pugnas vitio parentum","Rara juventus."]},{"k":"v","lines":["Quem vocet divum populus ruentis","Imperi rebus? prece qua fatigent","Virgines sanctae minus audientem","Carmina Vestam?"]},{"k":"v","lines":["Cui dabit partes scelus expiandi","Juppiter? Tandem venias precamur","Nube candentes humeros amictus,","Augur Apollo;"]},{"k":"v","lines":["Sive tu mavis, Erycina ridens,","Quam Jocus circum volat et Cupido;","Sive neglectum genus et nepotes","Respicis auctor,"]},{"k":"v","lines":["Heu nimis longo satiate ludo,","Quem juvat clamor galeaeque leves","Acer et Mauri peditis cruentum","Voltus in hostem;"]},{"k":"v","lines":["Sive mutata juvenem figura","Ales in terris imitaris, almae","Filius Maiae, patiens vocari","Caesaris ultor:"]},{"k":"v","lines":["Serus in caelum redeas diuque","Laetus intersis populo Quirini;","Neve te nostris vitiis iniquum","Ocior aura"]},{"k":"v","lines":["Tollat: hic magnos potius triumphos,","Hic ames dici pater atque princeps,","Neu sinas Medos equitare inultos","Te duce, Caesar."]}]}