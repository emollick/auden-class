{"id":"o2-04","label":"II.4","group":"Liber II","blocks":[{"k":"v","lines":["Ne sit ancillae tibi amor pudori,","Xanthia Phoceu! Prius insolentem","Serva Briseis niveo colore","Movit Achillem;"]},{"k":"v","lines":["Movit Ajacem Telamone natum","Forma captivae dominum Tecmessae;","Arsit Atrides medio in triumpho","Virgine rapta,"]},{"k":"v","lines":["Barbarae postquam cecidere turmae","Thessalo victore et ademptus Hector","Tradidit fessis leviora tolli","Pergama Grais."]},{"k":"v","lines":["Nescias an te generum beati","Phyllidis flavae decorent parentes:","Regium certe genus et penates","Maeret iniquos."]},{"k":"v","lines":["Crede non illam tibi de scelesta","Plebe dilectam, neque sic fidelem,","Sic lucro aversam potuisse nasci","Matre pudenda."]},{"k":"v","lines":["Brachia et voltum teretesque suras","Integer laudo; fuge suspicari,","Cujus octavum trepidavit aetas","Claudere lustrum."]}]}