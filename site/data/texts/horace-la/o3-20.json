{"id":"o3-20","label":"III.20","group":"Liber III","blocks":[{"k":"v","lines":["Non vides, quanto moveas periclo,","Pyrrhe, Gaetulae catulos leaenae?","Dura post paullo fugies inaudax","Proelia raptor"]},{"k":"v","lines":["Cum per obstantes juvenum catervas","Ibit insignem repetens Nearchum,","Grande certamen tibi praeda cedat","Major an illi."]},{"k":"v","lines":["Interim, dum tu celeres sagittas","Promis, haec dentes acuit timendos,","Arbiter pugnae posuisse nudo","Sub pede palmam"]},{"k":"v","lines":["Fertur, et leni recreare vento","Sparsum odoratis humerum capillis,","Qualis aut Nireus fuit aut aquosa","Raptus ab Ida."]}]}