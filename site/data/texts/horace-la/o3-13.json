{"id":"o3-13","label":"III.13","group":"Liber III","blocks":[{"k":"v","lines":["O fons Bandusiae, splendidior vitro,","Dulci digne mero non sine floribus,","Cras donaberis haedo","Cui frons turgida cornibus"]},{"k":"v","lines":["Primis et venerem et proelia destinat;","Frustra: nam gelidos inficiet tibi","Rubro sanguine rivos","Lascivi suboles gregis."]},{"k":"v","lines":["Te flagrantis atrox hora Caniculae","Nescit tangere, tu frigus amabile","Fessis vomere tauris","Praebes et pecori vago."]},{"k":"v","lines":["Fies nobilium tu quoque fontium,","Me dicente cavis impositam ilicem","Saxis, unde loquaces","Lymphae desiliunt tuae."]}]}