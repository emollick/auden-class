{"id":"o3-27","label":"III.27","group":"Liber III","blocks":[{"k":"v","lines":["Impios parrae recinentis omen","Ducat et praegnans canis aut ab agro","Rava decurrens lupa Lanuvino","Fetaque vulpes."]},{"k":"v","lines":["Rumpat et serpens iter institutum","Si per obliquum similis sagittae","Terruit mannos: ego cui timebo","Providus auspex,"]},{"k":"v","lines":["Antequam stantes repetat paludes","Imbrium divina avis imminentum,","Oscinem corvum prece suscitabo","Solis ab ortu."]},{"k":"v","lines":["Sis licet felix ubicunque mavis,","Et memor nostri, Galatea, vivas,","Teque nec laevus vetet ire picus","Nec vaga cornix."]},{"k":"v","lines":["Sed vides quanto trepidet tumultu","Pronus Orion. Ego quid sit ater","Hadriae novi sinus et quid albus","Peccet Iapyx."]},{"k":"v","lines":["Hostium uxores puerique caecos","Sentiant motus orientis Austri et","Aequoris nigri fremitum et trementes","Verbere ripas."]},{"k":"v","lines":["Sic et Europe niveum doloso","Credidit tauro latus et scatentem","Beluis pontum mediasque fraudes","Palluit audax."]},{"k":"v","lines":["Nuper in pratis studiosa florum et","Debitae Nymphis opifex coronae","Nocte sublustri nihil astra praeter","Vidit et undas."]},{"k":"v","lines":["Quae simul centum tetigit potentem","Oppidis Creten: Pater, o relictum","Filiae nomen pietasque, dixit,","Victa furore!"]},{"k":"v","lines":["Unde quo veni? Levis una mors est","Virginum culpae. Vigilansne ploro","Turpe commissum, an vitiis carentem","Ludit imago"]},{"k":"v","lines":["Vana quae porta fugiens eburna","Somnium ducit? Meliusne fluctus","Ire per longos fuit an recentes","Carpere flores?"]},{"k":"v","lines":["Si quis infamem mihi nunc juvencum","Dedat iratae lacerare ferro et","Frangere enitar modo multum amati","Cornua monstri."]},{"k":"v","lines":["Impudens liqui patrios Penates,","Impudens Orcum moror. O deorum","Si quis haec audis, utinam inter errem","Nuda leones!"]},{"k":"v","lines":["Antequam turpis macies decentes","Occupet malas, teneraeque sucus","Defluat praedae, speciosa quaero","Pascere tigres."]},{"k":"v","lines":["Vilis Europe, pater urget absens:","Quid mori cessas? Potes hac ab orno","Pendulum zona bene te secuta","Laedere collum."]},{"k":"v","lines":["Sive te rupes et acuta leto","Saxa delectant age te procellae","Crede veloci, nisi herile mavis","Carpere pensum"]},{"k":"v","lines":["Regius sanguis dominaeque tradi","Barbarae pellex.—Aderat querenti","Perfidum ridens Venus et remisso","Filius arcu."]},{"k":"v","lines":["Mox ubi lusit satis: Abstineto,","Dixit, irarum calidaeque rixae","Cum tibi invisus laceranda reddet","Cornua taurus."]},{"k":"v","lines":["Uxor invicti Jovis esse nescis:","Mitte singultus; bene ferre magnam","Disce fortunam; tua sectus orbis","Nomina ducet."]}]}