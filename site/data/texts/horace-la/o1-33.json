{"id":"o1-33","label":"I.33","group":"Liber I","blocks":[{"k":"v","lines":["Albi, ne doleas plus nimio memor","Immitis Glycerae, neu miserabiles","Decantes elegos cur tibi junior","Laesa praeniteat fide."]},{"k":"v","lines":["Insignem tenui fronte Lycorida","Cyri torret amor, Cyrus in asperam","Declinat Pholoën; sed prius Apulis","Jungentur capreae lupis"]},{"k":"v","lines":["Quam turpi Pholoë peccet adultero.","Sic visum Veneri, cui placet impares","Formas atque animos sub juga aënea","Saevo mittere cum joco."]},{"k":"v","lines":["Ipsum me, melior cum peteret Venus,","Grata detinuit compede Myrtale","Libertina, fretis acrior Hadriae","Curvantis Calabros sinus."]}]}