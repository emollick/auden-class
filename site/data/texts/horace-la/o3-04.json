{"id":"o3-04","label":"III.4","group":"Liber III","blocks":[{"k":"v","lines":["Descende caelo et dic age tibia","Regina longum Calliope melos,","Seu voce nunc mavis acuta,","Seu fidibus citharaque Phoebi."]},{"k":"v","lines":["Auditis, an me ludit amabilis","Insania? Audire et videor pios","Errare per lucos amoenae","Quos et aquae subeunt et aurae."]},{"k":"v","lines":["Me fabulosae Vulture in Apulo","Altricis extra limen Apuliae","Ludo fatigatumque somno","Fronde nova puerum palumbes"]},{"k":"v","lines":["Texere, mirum quod foret omnibus,","Quicunque celsae nidum Acherontiae","Saltusque Bantinos et arvum","Pingue tenent humilis Forenti,"]},{"k":"v","lines":["Ut tuto ab atris corpore viperis","Dormirem et ursis, ut premerer sacra","Lauroque collataque myrto,","Non sine dis animosus infans."]},{"k":"v","lines":["Vester, Camenae, vester in arduos","Tollor Sabinos, seu mihi frigidum","Praeneste seu Tibur supinum","Seu liquidae placuere Baiae."]},{"k":"v","lines":["Vestris amicum fontibus et choris","Non me Philippis versa acies retro,","Devota non exstinxit arbos,","Nec Sicula Palinurus unda."]},{"k":"v","lines":["Utcunque mecum vos eritis, libens","Insanientem navita Bosporum","Tentabo et urentes arenas","Litoris Assyrii viator;"]},{"k":"v","lines":["Visam Britannos hospitibus feros","Et laetum equino sanguine Concanum,","Visam pharetratos Gelonos","Et Scythicum inviolatus amnem."]},{"k":"v","lines":["Vos Caesarem altum, militia simul","Fessas cohortes addidit oppidis,","Finire quaerentem labores","Pierio recreatis antro."]},{"k":"v","lines":["Vos lene consilium et datis et dato","Gaudetis almae. Scimus, ut impios","Titanas immanemque turmam","Fulmine sustulerit caduco,"]},{"k":"v","lines":["Qui terram inertem, qui mare temperat","Ventosum, et urbes regnaque tristia,","Divosque mortalesque turbas","Imperio regit unus aequo."]},{"k":"v","lines":["Magnum illa terrorem intulerat Jovi","Fidens juventus horrida brachiis,","Fratresque tendentes opaco","Pelion imposuisse Olympo."]},{"k":"v","lines":["Sed quid Typhoëus et validus Mimas,","Aut quid minaci Porphyrion statu,","Quid Rhoetus evolsisque truncis","Enceladus jaculator audax"]},{"k":"v","lines":["Contra sonantem Palladis aegida","Possent ruentes? Hinc avidus stetit","Volcanus, hinc matrona Juno et","Nunquam humeris positurus arcum,"]},{"k":"v","lines":["Qui rore puro Castaliae lavit","Crines solutos, qui Lyciae tenet","Dumeta natalemque silvam,","Delius et Patareus Apollo."]},{"k":"v","lines":["Vis consili expers mole ruit sua:","Vim temperatam di quoque provehunt","In majus; idem odere vires","Omne nefas animo moventes."]},{"k":"v","lines":["Testis mearum centimanus Gyas","Sententiarum, notus et integrae","Tentator Orion Dianae","Virginea domitus sagitta."]},{"k":"v","lines":["Injecta monstris Terra dolet suis","Maeretque partus fulmine luridum","Missos ad Orcum; nec peredit","Impositam celer ignis Aetnen,"]},{"k":"v","lines":["Incontinentis nec Tityi jecur","Reliquit ales, nequitiae additus","Custos; amatorem trecentae","Pirithoum cohibent catenae."]}]}