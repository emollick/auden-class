{"id":"o3-09","label":"III.9","group":"Liber III","blocks":[{"k":"v","lines":["Donec gratus eram tibi","Nec quisquam potior brachia candidae","Cervici juvenis dabat,","Persarum vigui rege beatior."]},{"k":"v","lines":["Donec non alia magis","Arsisti neque erat Lydia post Chloën,","Multi Lydia nominis","Romana vigui clarior Ilia."]},{"k":"v","lines":["Me nunc Thressa Chloë regit","Dulces docta modos et citharae sciens,","Pro qua non metuam mori","Si parcent animae fata superstiti."]},{"k":"v","lines":["Me torret face mutua","Thurini Calais filius Ornyti,","Pro quo bis patiar mori","Si parcent puero fata superstiti."]},{"k":"v","lines":["Quid si prisca redit Venus","Diductosque jugo cogit aëneo,","Si flava excutitur Chloë","Rejectaeque patet janua Lydiae?"]},{"k":"v","lines":["Quamquam sidere pulchrior","Ille est, tu levior cortice et improbo","Iracundior Hadria,","Tecum vivere amem, tecum obeam libens."]}]}