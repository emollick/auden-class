{"id":"o4-04","label":"IV.4","group":"Liber IV","blocks":[{"k":"v","lines":["Qualem ministrum fulminis alitem,","Cui rex deorum regnum in aves vagas","Permisit expertus fidelem","Juppiter in Ganymede flavo,"]},{"k":"v","lines":["Olim juventas et patrius vigor","Nido laborum propulit inscium,","Vernique jam nimbis remotis","Insolitos docuere nisus"]},{"k":"v","lines":["Venti paventem, mox in ovilia","Demisit hostem vividus impetus,","Nunc in reluctantes dracones","Egit amor dapis atque pugnae:"]},{"k":"v","lines":["Qualemve laetis caprea pascuis","Intenta fulvae matris ab ubere","Jam lacte depulsum leonem","Dente novo peritura vidit:"]},{"k":"v","lines":["Videre Raetis bella sub Alpibus","Drusum gerentem Vindelici;—quibus","Mos unde deductus per omne","Tempus Amazonia securi"]},{"k":"v","lines":["Dextras obarmet quaerere distuli,","Nec scire fas est omnia;—sed diu","Lateque victrices catervae","Consiliis juvenis revictae"]},{"k":"v","lines":["Sensere quid mens rite, quid indoles","Nutrita faustis sub penetralibus","Posset, quid Augusti paternus","In pueros animus Nerones."]},{"k":"v","lines":["Fortes creantur fortibus et bonis;","Est in juvencis, est in equis patrum","Virtus, neque imbellem feroces","Progenerant aquilae columbam:"]},{"k":"v","lines":["Doctrina sed vim promovet insitam,","Rectique cultus pectora roborant;","Utcunque defecere mores","Indecorant bene nata culpae."]},{"k":"v","lines":["Quid debeas, o Roma, Neronibus,","Testis Metaurum flumen et Hasdrubal","Devictus et pulcher fugatis","Ille dies Latio tenebris"]},{"k":"v","lines":["Qui primus alma risit adorea,","Dirus per urbes Afer ut Italas","Ceu flamma per taedas vel Eurus","Per Siculas equitavit undas."]},{"k":"v","lines":["Post hoc secundis usque laboribus","Romana pubes crevit et impio","Vastata Poenorum tumultu","Fana deos habuere rectos;"]},{"k":"v","lines":["Dixitque tandem perfidus Hannibal:","Cervi luporum praeda rapacium","Sectamur ultro quos opimus","Fallere et effugere est triumphus."]},{"k":"v","lines":["Gens quae cremato fortis ab Ilio","Jactata Tuscis aequoribus sacra","Natosque maturosque patres","Pertulit Ausonias ad urbes,"]},{"k":"v","lines":["Duris ut ilex tonsa bipennibus","Nigrae feraci frondis in Algido,","Per damna, per caedes, ab ipso","Ducit opes animumque ferro."]},{"k":"v","lines":["Non hydra secto corpore firmior","Vinci dolentem crevit in Herculem,","Monstrumve submisere Colchi","Maius Echioniaeve Thebae."]},{"k":"v","lines":["Merses profundo, pulchrior evenit:","Luctere, multa proruet integrum","Cum laude victorem geretque","Proelia conjugibus loquenda."]},{"k":"v","lines":["Karthagini jam non ego nuntios","Mittam superbos: occidit, occidit","Spes omnis et fortuna nostri","Nominis Hasdrubale interempto."]},{"k":"v","lines":["Nil Claudiae non perficient manus,","Quas et benigno numine Juppiter","Defendit et curae sagaces","Expediunt per acuta belli."]}]}