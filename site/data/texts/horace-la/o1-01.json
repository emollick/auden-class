{"id":"o1-01","label":"I.1","group":"Liber I","blocks":[{"k":"v","lines":["Maecenas atavis edite regibus","O et praesidium et dulce decus meum,","Sunt quos curriculo pulverem Olympicum","Collegisse juvat metaque fervidis"]},{"k":"v","lines":["Evitata rotis palmaque nobilis.","Terrarum dominos evehit ad Deos,","Hunc si mobilium turba Quiritium","Certat tergeminis tollere honoribus;"]},{"k":"v","lines":["Illum si proprio condidit horreo","Quidquid de Libycis verritur areis.","Gaudentem patrios findere sarculo","Agros Attalicis conditionibus"]},{"k":"v","lines":["Nunquam dimoveas, ut trabe Cypria","Myrtoum pavidus nauta secet mare.","Luctantem Icariis fluctibus Africum","Mercator metuens otium et oppidi"]},{"k":"v","lines":["Laudat rura sui; mox reficit rates","Quassas indocilis pauperiem pati.","Est qui nec veteris pocula Massici","Nec partem solido demere de die"]},{"k":"v","lines":["Spernit, nunc viridi membra sub arbuto","Stratus, nunc ad aquae lene caput sacrae.","Multos castra juvant et lituo tubae","Permixtus sonitus bellaque matribus"]},{"k":"v","lines":["Detestata. Manet sub Jove frigido","Venator tenerae conjugis immemor,","Seu visa est catulis cerva fidelibus,","Seu rupit teretes Marsus aper plagas."]},{"k":"v","lines":["Me doctarum hederae praemia frontium","Dis miscent superis; me gelidum nemus","Nympharumque leves cum Satyris chori","Secernunt populo, si neque tibias"]},{"k":"v","lines":["Euterpe cohibet nec Polyhymnia","Lesboum refugit tendere barbiton.","Quod si me lyricis vatibus inseris,","Sublimi feriam sidera vertice."]}]}