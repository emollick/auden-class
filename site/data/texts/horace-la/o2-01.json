{"id":"o2-01","label":"II.1","group":"Liber II","blocks":[{"k":"v","lines":["Motum ex Metello consule civicum","Bellique causas et vitia et modos","Ludumque Fortunae gravesque","Principum amicitias et arma"]},{"k":"v","lines":["Nondum expiatis uncta cruoribus,","Periculosae plenum opus aleae,","Tractas et incedis per ignes","Suppositos cineri doloso."]},{"k":"v","lines":["Paullum severae Musa tragoediae","Desit theatris: mox ubi publicas","Res ordinaris grande munus","Cecropio repetes cothurno,"]},{"k":"v","lines":["Insigne maestis praesidium reis","Et consulenti, Pollio, curiae,","Cui laurus aeternos honores","Delmatico peperit triumpho."]},{"k":"v","lines":["Jam nunc minaci murmure cornuum","Perstringis aures, jam litui strepunt,","Jam fulgor armorum fugaces","Terret equos equitumque voltus:"]},{"k":"v","lines":["Audire magnos jam videor duces","Non indecoro pulvere sordidos,","Et cuncta terrarum subacta","Praeter atrocem animum Catonis."]},{"k":"v","lines":["Juno et deorum quisquis amicior","Afris inulta cesserat impotens","Tellure victorum nepotes","Rettulit inferias Jugurthae."]},{"k":"v","lines":["Quis non Latino sanguine pinguior","Campus sepulcris impia proelia","Testatur auditumque Medis","Hesperiae sonitum ruinae?"]},{"k":"v","lines":["Qui gurges, aut quae flumina lugubris","Ignara belli? quod mare Dauniae","Non decoloravere caedes?","Quae caret ora cruore nostro?"]},{"k":"v","lines":["Sed ne relictis, Musa procax, jocis,","Ceae retractes munera neniae:","Mecum Dionaeo sub antro","Quaere modos leviore plectro."]}]}