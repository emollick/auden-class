{"id":"cs","label":"Carmen Saeculare","blocks":[{"k":"v","lines":["Phoebe silvarumque potens Diana,","Lucidum caeli decus, o colendi","Semper et culti, date, quae precamur","Tempore sacro,"]},{"k":"v","lines":["Quo Sibyllini monuere versus","Virgines lectas puerosque castos","Dis quibus septem placuere colles","Dicere carmen."]},{"k":"v","lines":["Alme Sol, curru nitido diem qui","Promis et celas aliusque et idem","Nasceris, possis nihil urbe Roma","Visere majus."]},{"k":"v","lines":["Rite maturos aperire partus","Lenis, Ilithyia, tuere matres,","Sive tu Lucina probas vocari","Seu Genitalis."]},{"k":"v","lines":["Diva, producas subolem patrumque","Prosperes decreta super jugandis","Feminis prolisque novae feraci","Lege marita,"]},{"k":"v","lines":["Certus undenos decies per annos","Orbis ut cantus referatque ludos","Ter die claro totiesque grata","Nocte frequentes."]},{"k":"v","lines":["Vosque veraces cecinisse, Parcae,","Quod semel dictum est stabilisque rerum","Terminus servat, bona jam peractis","Jungite fata."]},{"k":"v","lines":["Fertilis frugum pecorisque Tellus","Spicea donet Cererem corona;","Nutriant fetus et aquae salubres","Et Jovis aurae."]},{"k":"v","lines":["Condito mitis placidusque telo","Supplices audi pueros, Apollo:","Siderum regina bicornis audi,","Luna, puellas."]},{"k":"v","lines":["Roma si vestrum est opus, Iliaeque","Litus Etruscum tenuere turmae,","Jussa pars mutare Lares et urbem","Sospite cursu,"]},{"k":"v","lines":["Cui per ardentem sine fraude Trojam","Castus Aeneas patriae superstes","Liberum munivit iter, daturus","Plura relictis:"]},{"k":"v","lines":["Di, probos mores docili juventae,","Di, senectuti placidae quietem,","Romulae genti date remque prolemque","Et decus omne!"]},{"k":"v","lines":["Quaeque vos bubus veneratur albis","Clarus Anchisae Venerisque sanguis,","Impetret, bellante prior, jacentem","Lenis in hostem!"]},{"k":"v","lines":["Jam mari terraque manus potentes","Medus Albanasque timet secures,","Jam Scythae responsa petunt, superbi","Nuper, et Indi."]},{"k":"v","lines":["Jam Fides et Pax et Honos Pudorque","Priscus et neglecta redire Virtus","Audet, apparetque beata pleno","Copia cornu."]},{"k":"v","lines":["Augur et fulgente decorus arcu","Phoebus acceptusque novem Camenis,","Qui salutari levat arte fessos","Corporis artus,"]},{"k":"v","lines":["Si Palatinas videt aequus arces","Remque Romanam Latiumque, felix","Alterum in lustrum meliusque semper","Proroget aevum."]},{"k":"v","lines":["Quaeque Aventinum tenet Algidumque,","Quindecim Diana preces virorum","Curet et votis puerorum amicas","Applicet aures."]},{"k":"v","lines":["Haec Jovem sentire deosque cunctos","Spem bonam certamque domum reporto,","Doctus et Phoebi chorus et Dianae","Dicere laudes."]}]}