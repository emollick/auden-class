{"id":"o3-18","label":"III.18","group":"Liber III","blocks":[{"k":"v","lines":["Faune, Nympharum fugientum amator,","Per meos fines et aprica rura","Lenis incedas abeasque parvis","Aequus alumnis,"]},{"k":"v","lines":["Si tener pleno cadit haedus anno,","Larga nec desunt Veneris sodali","Vina craterae. Vetus ara multo","Fumat odore,"]},{"k":"v","lines":["Ludit herboso pecus omne campo,","Cum tibi Nonae redeunt Decembres;","Festus in pratis vacat otioso","Cum bove pagus;"]},{"k":"v","lines":["Inter audaces lupus errat agnos;","Spargit agrestes tibi silva frondes;","Gaudet invisam pepulisse fossor","Ter pede terram."]}]}