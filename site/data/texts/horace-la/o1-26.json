{"id":"o1-26","label":"I.26","group":"Liber I","blocks":[{"k":"v","lines":["Musis amicus tristitiam et metus","Tradam protervis in mare Creticum","Portare ventis, quis sub Arcto","Rex gelidae metuatur orae,"]},{"k":"v","lines":["Quid Tiridaten terreat unice","Securus. O, quae fontibus integris","Gaudes, apricos necte flores,","Necte meo Lamiae coronam,"]},{"k":"v","lines":["Pimplea dulcis! Nil sine te mei","Prosunt honores: hunc fidibus novis,","Hunc Lesbio sacrare plectro","Teque tuasque decet sorores."]}]}