{"id":"o2-16","label":"II.16","group":"Liber II","blocks":[{"k":"v","lines":["Otium divos rogat in patente","Prensus Aegaeo, simul atra nubes","Condidit lunam neque certa fulgent","Sidera nautis;"]},{"k":"v","lines":["Otium bello furiosa Thrace,","Otium Medi pharetra decori,","Grosphe, non gemmis neque purpura ve-","nale neque auro."]},{"k":"v","lines":["Non enim gazae neque consularis","Summovet lictor miseros tumultus","Mentis, et curas laqueata circum","Tecta volantes."]},{"k":"v","lines":["Vivitur parvo bene cui paternum","Splendet in mensa tenui salinum,","Nec leves somnos timor aut cupido","Sordidus aufert."]},{"k":"v","lines":["Quid brevi fortes jaculamur aevo","Multa? Quid terras alio calentes","Sole mutamus? Patriae quis exsul","Se quoque fugit?"]},{"k":"v","lines":["Scandit aeratas vitiosa naves","Cura nec turmas equitum relinquit,","Ocior cervis et agente nimbos","Ocior Euro."]},{"k":"v","lines":["Laetus in praesens animus quod ultra est","Oderit curare et amara lento","Temperet risu; nihil est ab omni","Parte beatum."]},{"k":"v","lines":["Abstulit clarum cita mors Achillem,","Longa Tithonum minuit senectus,","Et mihi forsan tibi quod negarit,","Porriget hora."]},{"k":"v","lines":["Te greges centum Siculaeque circum","Mugiunt vaccae, tibi tollit hinnitum","Apta quadrigis equa, te bis Afro","Murice tinctae"]},{"k":"v","lines":["Vestiunt lanae: mihi parva rura et","Spiritum Graiae tenuem Camenae","Parca non mendax dedit et malignum","Spernere volgus."]}]}