{"id":"o3-06","label":"III.6","group":"Liber III","blocks":[{"k":"v","lines":["Delicta majorum immeritus lues,","Romane, donec templa refeceris","Aedesque labentes deorum et","Foeda nigro simulacra fumo."]},{"k":"v","lines":["Dis te minorem quod geris imperas:","Hinc omne principium, huc refer exitum.","Di multa neglecti dederunt","Hesperiae mala luctuosae."]},{"k":"v","lines":["Jam bis Monaeses et Pacori manus","Non auspicatos contudit impetus","Nostros et adjecisse praedam","Torquibus exiguis renidet."]},{"k":"v","lines":["Paene occupatam seditionibus","Delevit Urbem Dacus et Aethiops,","Hic classe formidatus, ille","Missilibus melior sagittis."]},{"k":"v","lines":["Fecunda culpae secula nuptias","Primum inquinavere et genus et domos;","Hoc fonte derivata clades","In patriam populumque fluxit."]},{"k":"v","lines":["Motus doceri gaudet Ionicos","Matura virgo et fingitur artibus;","Jam nunc et incestos amores","De tenero meditatur ungui:"]},{"k":"v","lines":["Mox juniores quaerit adulteros","Inter mariti vina, neque eligit","Cui donet impermissa raptim","Gaudia luminibus remotis;"]},{"k":"v","lines":["Sed jussa coram non sine conscio","Surgit marito, seu vocat institor","Seu navis Hispanae magister,","Dedecorum pretiosus emptor."]},{"k":"v","lines":["Non his juventus orta parentibus","Infecit aequor sanguine Punico,","Pyrrhumque et ingentem cecidit","Antiochum Hannibalemque dirum;"]},{"k":"v","lines":["Sed rusticorum mascula militum","Proles, Sabellis docta ligonibus","Versare glebas et severae","Matris ad arbitrium recisos"]},{"k":"v","lines":["Portare fustes, sol ubi montium","Mutaret umbras et juga demeret","Bobus fatigatis, amicum","Tempus agens abeunte curru."]},{"k":"v","lines":["Damnosa quid non imminuit dies?","Aetas parentum pejor avis tulit","Nos nequiores, mox daturos","Progeniem vitiosiorem."]}]}