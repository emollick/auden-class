{"id":"o1-21","label":"I.21","group":"Liber I","blocks":[{"k":"v","lines":["Dianam tenerae dicite virgines,","Intonsum, pueri, dicite Cynthium","Latonamque supremo","Dilectam penitus Jovi."]},{"k":"v","lines":["Vos laetam fluviis et nemorum coma,","Quaecunque aut gelido prominet Algido","Nigris aut Erymanthi","Silvis aut viridis Cragi;"]},{"k":"v","lines":["Vos Tempe totidem tollite laudibus,","Natalemque, mares, Delon Apollinis,","Insignemque pharetra","Fraternaque humerum lyra."]},{"k":"v","lines":["Hic bellum lacrumosum, hic miseram famem","Pestemque a populo et principe Caesare in","Persas atque Britannos","Vestra motus aget prece."]}]}