{"id":"o3-08","label":"III.8","group":"Liber III","blocks":[{"k":"v","lines":["Martiis caelebs quid agam Kalendis,","Quid velint flores et acerra thuris","Plena miraris, positusque carbo in","Caespite vivo,"]},{"k":"v","lines":["Docte sermones utriusque linguae?","Voveram dulces epulas et album","Libero caprum prope funeratus","Arboris ictu."]},{"k":"v","lines":["Hic dies anno redeunte festus","Corticem adstrictum pice dimovebit","Amphorae fumum bibere institutae","Consule Tullo."]},{"k":"v","lines":["Sume, Maecenas, cyathos amici","Sospitis centum et vigiles lucernas","Perfer in lucem; procul omnis esto","Clamor et ira."]},{"k":"v","lines":["Mitte civiles super urbe curas:","Occidit Daci Cotisonis agmen,","Medus infestus sibi luctuosis","Dissidet armis,"]},{"k":"v","lines":["Servit Hispanae vetus hostis orae","Cantaber sera domitus catena;","Jam Scythae laxo meditantur arcu","Cedere campis."]},{"k":"v","lines":["Neglegens ne qua populus laboret","Parce privatus nimium cavere;","Dona praesentis cape laetus horae et","Linque severa."]}]}