{"id":"o1-30","label":"I.30","group":"Liber I","blocks":[{"k":"v","lines":["O Venus, regina Cnidi Paphique,","Sperne dilectam Cypron, et vocantis","Thure te multo Glycerae decoram","Transfer in aedem."]},{"k":"v","lines":["Fervidus tecum puer et solutis","Gratiae zonis properentque Nymphae","Et parum comis sine te Juventas","Mercuriusque."]}]}